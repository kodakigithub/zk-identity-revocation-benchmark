# --- Sepolia deployment (contracts) ---
# RPC endpoint for Sepolia, e.g. from Alchemy/Infura. Never commit the real file.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Private key of the deployer/issuer EOA (0x-prefixed, 64 hex chars). Testnet funds only.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# --- Local development ---
# URL of the local Hardhat node used by the demo, benchmarks and apps.
LOCAL_RPC_URL=http://127.0.0.1:8545

# --- Issuer demo key (Ed25519, hex). Optional: the SDK generates one if unset.
# This is a research prototype with ONE hardcoded issuer; do not reuse elsewhere.
ISSUER_ED25519_PRIVATE_KEY=
